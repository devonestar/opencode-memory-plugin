{
  "name": "opencode-durable-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first durable memory plugin for the OpenCode coding agent: plain Markdown stores, deterministic BM25F recall with Korean n-grams, scope-isolated global and project memory, and curation that auto-applies only provably exact duplicates.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent-memory",
    "persistent-memory",
    "long-term-memory",
    "coding-agent",
    "local-first",
    "bm25",
    "markdown",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "devonestar",
  "homepage": "https://github.com/devonestar/opencode-durable-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devonestar/opencode-durable-memory.git"
  },
  "bugs": {
    "url": "https://github.com/devonestar/opencode-durable-memory/issues"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@opencode-ai/sdk": "1.18.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
